<Window x:Class="AgentOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0">

    <Grid>
        <!-- Drawable surface. Only receives input while in Draw Mode; the window's
             extended style controls whether clicks reach it at all (see MainWindow.xaml.cs). -->
        <InkCanvas x:Name="DrawSurface"
                   Background="Transparent"
                   EditingMode="Ink" />

        <!-- Both indicators below are anchored inside this sub-region, which code-behind
             (PositionPrimaryMonitorRegion) sizes and offsets to exactly cover the primary
             monitor. Anchoring directly to the outer Grid would place them relative to the
             whole virtual desktop's bounding box instead, which on a multi-monitor setup can
             land on a different physical screen than the one you're looking at. -->
        <Grid x:Name="PrimaryMonitorRegion"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              IsHitTestVisible="False">
            <!-- Avatar face, eyes tracking the live mouse position (see MainWindow.xaml.cs).
                 Purely visual feedback that the agent is "watching"; opaque and high-contrast
                 so it reads clearly against any wallpaper. -->
            <Grid x:Name="FaceContainer"
                  Width="140" Height="140"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="FaceHead" Fill="#F07C3AED" Stroke="White" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="Black" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Canvas>
                    <Ellipse Width="34" Height="34" Fill="White" Canvas.Left="28" Canvas.Top="55"/>
                    <Ellipse Width="14" Height="14" Fill="#202020" Canvas.Left="35" Canvas.Top="62">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="LeftPupilTransform"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="34" Height="34" Fill="White" Canvas.Left="78" Canvas.Top="55"/>
                    <Ellipse Width="14" Height="14" Fill="#202020" Canvas.Left="85" Canvas.Top="62">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="RightPupilTransform"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Always-visible mode indicator, pinned top-right of the primary monitor. Small
                 and unobtrusive but deliberately never hidden: an invisible overlay whose input
                 mode you can't see is a trap, both for usability and for safety. -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    CornerRadius="6"
                    Padding="10,4"
                    Background="#EE202020">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Pass-through" Foreground="White" FontFamily="Consolas" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

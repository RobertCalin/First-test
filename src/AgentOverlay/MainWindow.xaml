<Window x:Class="AgentOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0">

    <Grid>
        <!-- Drawable surface. Only receives input while in Draw Mode; the window's
             extended style controls whether clicks reach it at all (see MainWindow.xaml.cs). -->
        <InkCanvas x:Name="DrawSurface"
                   Background="Transparent"
                   EditingMode="Ink" />

        <!-- Avatar face, centered, eyes tracking the live mouse position (see
             MainWindow.xaml.cs). Purely visual feedback that the agent is "watching" --
             never hit-test visible, so it can never block clicks or drawing. -->
        <Grid x:Name="FaceContainer"
              Width="140" Height="140"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Ellipse x:Name="FaceHead" Fill="#DD2B2B33" Stroke="Gray" StrokeThickness="2"/>
            <Canvas>
                <Ellipse Width="34" Height="34" Fill="White" Canvas.Left="28" Canvas.Top="55"/>
                <Ellipse Width="14" Height="14" Fill="#202020" Canvas.Left="35" Canvas.Top="62">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="LeftPupilTransform"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="34" Height="34" Fill="White" Canvas.Left="78" Canvas.Top="55"/>
                <Ellipse Width="14" Height="14" Fill="#202020" Canvas.Left="85" Canvas.Top="62">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="RightPupilTransform"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Always-visible mode indicator, pinned top-right. Small and unobtrusive but
             deliberately never hidden: an invisible overlay whose input mode you can't
             see is a trap, both for usability and for safety. -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                CornerRadius="6"
                Padding="10,4"
                Background="#CC202020">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Pass-through" Foreground="White" FontFamily="Consolas" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
